{
  "name": "lagaitha",
  "version": "0.1.0",
  "private": true,
  "description": "لَگيتها — Lost & Found platform for Mosul",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run db:deploy:auto && next build",
    "db:deploy:auto": "sh -c 'if [ -n \"$DATABASE_URL\" ]; then prisma migrate deploy; else echo \"DATABASE_URL not set at build time — skipping migrate deploy\"; fi'",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "clsx": "2.1.1",
    "leaflet": "1.9.4",
    "lucide-react": "1.38.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "3.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.20",
    "@types/node": "22.18.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.11"
  }
}
