# ---- Database ----------------------------------------------------------
DATABASE_URL="postgresql://lagaitha:lagaitha@127.0.0.1:5432/lagaitha_dev"

# Used only by `npm test` (integration tests truncate tables).
TEST_DATABASE_URL="postgresql://lagaitha:lagaitha@127.0.0.1:5432/lagaitha_test"

# ---- Sessions ----------------------------------------------------------
# 32+ random bytes, base64. Generate with:  openssl rand -base64 48
SESSION_SECRET="dev-only-change-me-dev-only-change-me-dev-only-1234"

# ---- One-time code delivery --------------------------------------------
# Signing in is a password. A code is still needed to confirm an address at
# sign-up and to reset a forgotten password, so a driver must be configured
# before anyone can create an account.
# smtp     -> email via Gmail / Brevo / any SMTP host. FREE, no domain needed.
# resend   -> email via Resend. Best deliverability, needs a verified domain.
# twilio   -> real SMS, works internationally including Iraq (paid)
# http     -> any SMS gateway with a plain HTTP API (local Iraqi aggregators)
# console  -> code is printed to the server log (development only)
# disabled -> login is refused with a clear message
OTP_PROVIDER="console"

# Which identifier the sign-in screen asks for when the driver does not imply
# one (console / disabled). A real driver always wins.
AUTH_CHANNEL="email"

# --- OTP_PROVIDER=smtp — the free option -------------------------------
# Gmail: create an App Password (needs 2FA on the account), not your password.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"
# MAIL_FROM="لَگيتها <you@gmail.com>"
#
# Brevo (300/day free, higher limits than Gmail):
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_USER="your-brevo-login"
# SMTP_PASS="your-brevo-smtp-key"
# MAIL_FROM="لَگيتها <verified-sender@example.com>"

# --- OTP_PROVIDER=resend ------------------------------------------------
# RESEND_API_KEY="re_xxxxxxxx"
# MAIL_FROM="لَگيتها <no-reply@yourdomain.iq>"

# Makes every one-time code "000000", so the sign-up flow can be walked through
# without a mail server. MUST be unset in production.
OTP_DEV_FIXED_CODE="000000"

# --- OTP_PROVIDER=twilio ---
# TWILIO_ACCOUNT_SID="ACxxxxxxxx"
# TWILIO_AUTH_TOKEN="xxxxxxxx"
# Use a Messaging Service (Twilio picks the best sender) …
# TWILIO_MESSAGING_SERVICE_SID="MGxxxxxxxx"
# … or a single number you own:
# TWILIO_FROM="+15551234567"

# --- OTP_PROVIDER=http (local Iraqi SMS gateway) ---
# {phone}, {message} and {code} are substituted before sending.
# SMS_HTTP_URL="https://gateway.example.iq/api/send"
# SMS_HTTP_METHOD="POST"
# SMS_HTTP_BODY='{"to":"{phone}","text":"{message}","sender":"LAGAITHA"}'
# SMS_HTTP_HEADERS='{"Authorization":"Bearer xxxxxxxx"}'
# For a GET-style gateway, put the placeholders in the URL instead:
# SMS_HTTP_URL="https://gateway.example.iq/send?to={phone}&msg={message}&key=xxx"
# SMS_HTTP_METHOD="GET"

# ---- Storage -----------------------------------------------------------
# local -> files under ./storage, served by /api/media
# s3    -> any S3-compatible bucket (set the S3_* vars below)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL=""

UPLOAD_MAX_BYTES="8388608"

# ---- Maps --------------------------------------------------------------
# OpenStreetMap needs no key. Point this at your own tile cache in production
# and keep the attribution.
MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
MAP_TILE_ATTRIBUTION="© OpenStreetMap"

# ---- AI enhancement (entirely optional) --------------------------------
# none      -> no image/text analysis; reports work exactly the same
# anthropic -> set ANTHROPIC_API_KEY
AI_PROVIDER="none"
# ANTHROPIC_API_KEY=""

# ---- Public site -------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Set to "1" on staging to keep the whole site out of search engines.
SITE_NOINDEX="0"
